# ─── WhatsApp Cloud API (Meta) ───────────────────────────────
# Token de System User PERMANENTE (no el temporal de 24h/60d)
WA_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=
VERIFY_TOKEN=

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Base de datos (Supabase / Postgres) ─────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_SSL=true                # forzar SSL si el host no es *.supabase.com
# DB_CA_CERT=                # (work-unit 3) CA de Supabase si falla el TLS

# ─── Autorización (work-unit 1 — YA activo) ──────────────────
# Números autorizados, separados por coma. Formato internacional sin '+'.
# Si está vacío o ausente, la instancia NO arranca (fail-closed).
AUTHORIZED_NUMBERS=573001112233,573004445566

# ─── Identidad del negocio (work-unit 5 — PDF/Remisión) ──────
# BUSINESS_NAME=Distribuidora La Esperanza
# BUSINESS_NIT=900123456-7
# BUSINESS_ADDRESS=Cra 10 #20-30, Cali
# BUSINESS_PHONE=573001112233

# ─── Límites de costo (work-unit 4) ──────────────────────────
# DAILY_MESSAGE_CAP=2000

# ─── Servidor ────────────────────────────────────────────────
# PORT=3000
# ─── Límites de costo y abuso (work-unit 4 — YA activos) ─────
# Mensajes por minuto por número antes de frenar (default 30)
RATE_LIMIT_PER_MIN=30
# Tope de mensajes/día por instancia — techo de costo (default 2000)
DAILY_MESSAGE_CAP=2000