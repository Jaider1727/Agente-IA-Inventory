{
  "name": "agente-facturacion",
  "version": "1.0.0",
  "description": "WhatsApp invoicing agent with AI",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest",
    "lint": "eslint src scripts",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "1.17.0",
    "dotenv": "16.4.5",
    "express": "4.22.2",
    "openai": "4.67.1",
    "pdfkit": "0.15.0",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "16.2.0",
    "jest": "29.7.0",
    "prettier": "3.5.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
